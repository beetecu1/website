---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarDecoration from '../components/common/StarDecoration.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);

const prologueParagraphs = t('book847.prologue').split('\n').filter(Boolean);
const descriptionParagraphs = t('book847.description').split('\n').filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: '847',
  alternativeHeadline: t('book847.subtitle'),
  description: t('book847.teaser'),
  author: { '@type': 'Person', name: 'beetecu', alternateName: 'Elizabeth González' },
  inLanguage: 'es',
  bookFormat: 'https://schema.org/Paperback',
};
---

<BaseLayout
  title="847 — ¿Y si yo no soy yo?"
  description="Un ensayo para quien alguna vez se ha pillado a sí mismo haciendo algo habitual y ha tenido la sensación extraña de no saber cuándo empezó a hacerlo así."
  lang={lang}
  canonicalPath="/847"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center justify-center bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 overflow-hidden border-b border-slate-800/40">
    <!-- Subtle grid pattern -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(#10b981 1px, transparent 1px), linear-gradient(90deg, #10b981 1px, transparent 1px); background-size: 40px 40px;"
      aria-hidden="true"
    ></div>

    <!-- Glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full bg-emerald-500/5 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 text-center px-4 py-20 max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-mono font-bold rounded border border-emerald-500/20 mb-8 tracking-widest">
        {t('book847.genre').toUpperCase()} &nbsp;·&nbsp; {t('book847.badge').toUpperCase()}
      </span>
      <h1 class="font-mono text-8xl sm:text-9xl font-bold text-emerald-400 leading-none mb-4 drop-shadow-lg">
        847
      </h1>
      <p class="text-slate-300 text-xl sm:text-2xl italic mb-10">
        {t('book847.subtitle')}
      </p>
      <p class="text-slate-400 text-sm font-mono">beetecu</p>
    </div>
  </section>

  <!-- Main content -->
  <div class="bg-slate-950 text-slate-200">

    <!-- Prologue excerpt -->
    <section class="max-w-3xl mx-auto px-4 py-16 md:py-20">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px flex-1 bg-emerald-500/20"></div>
        <span class="font-mono text-xs text-emerald-500/60 tracking-widest uppercase">
          {t('book847.prologueLabel')}
        </span>
        <div class="h-px flex-1 bg-emerald-500/20"></div>
      </div>

      <blockquote class="border-l-2 border-emerald-500/40 pl-6 space-y-4">
        {prologueParagraphs.map((p) => (
          <p class="text-slate-300 text-lg leading-relaxed italic">{p}</p>
        ))}
      </blockquote>
    </section>

    <!-- System note divider -->
    <div class="max-w-3xl mx-auto px-4">
      <div class="font-mono text-xs text-emerald-500/30 border border-emerald-500/10 rounded-lg p-4 bg-slate-900/50">
        <span class="text-emerald-500/50">&gt;</span> UEBA_v847 | nodo_lector | estado: <span class="text-emerald-400/60">procesando</span><br />
        <span class="text-emerald-500/50">&gt;</span> patrones_detectados: <span class="text-emerald-400/60">pendiente_de_observación</span><br />
        <span class="text-emerald-500/50">&gt;</span> tiempo_estimado_hasta_convergencia: <span class="text-emerald-400/60">variable</span>
      </div>
    </div>

    <!-- What is it about -->
    <section class="max-w-3xl mx-auto px-4 py-16 md:py-20">
      <h2 class="font-title text-2xl font-bold text-emerald-400 mb-8">
        {t('book847.whatIsIt')}
      </h2>
      <div class="space-y-5">
        {descriptionParagraphs.map((p) => (
          <p class="text-slate-300 text-lg leading-relaxed">{p}</p>
        ))}
      </div>
    </section>

    <!-- Three pillars -->
    <section class="max-w-3xl mx-auto px-4 pb-16 md:pb-20">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { icon: '🔐', label: 'Ciberseguridad', desc: 'UEBA, SOC, comportamiento como dato' },
          { icon: '🧠', label: 'Psicología conductual', desc: 'Patrones, hábitos, el radio fijo' },
          { icon: '🌀', label: 'Filosofía', desc: 'Identidad, libre albedrío, lo que queda' },
        ].map((pillar) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 text-center">
            <div class="text-2xl mb-2">{pillar.icon}</div>
            <div class="font-semibold text-slate-200 mb-1">{pillar.label}</div>
            <div class="text-xs text-slate-500">{pillar.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-slate-800/60 py-16 md:py-20">
      <div class="max-w-xl mx-auto px-4 text-center">
        <div class="font-mono text-xs text-emerald-500/50 mb-4 tracking-widest">
          checkpoints_pendientes: 4
        </div>
        <h2 class="font-title text-3xl font-bold text-white mb-4">
          {t('book847.badge')}
        </h2>
        <p class="text-slate-400 mb-8">
          Escríbenos y te avisamos en cuanto esté disponible.
        </p>
        <a
          href="mailto:hola@beetecu.com?subject=Avísame%20cuando%20salga%20847"
          class="inline-block px-8 py-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-base rounded-full transition-colors shadow-lg shadow-emerald-500/20"
        >
          {t('book847.notifyCta')} →
        </a>
        <p class="text-slate-600 text-xs font-mono mt-4">hola@beetecu.com</p>
      </div>
    </section>

  </div>
</BaseLayout>
