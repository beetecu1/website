---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Book847Section from '../components/home/Book847Section.astro';
import SeriesIntro from '../components/home/SeriesIntro.astro';
import BookCarousel from '../components/home/BookCarousel.astro';

const lang = 'es' as const;
---

<BaseLayout
  title="beetecu — Libros"
  lang={lang}
  canonicalPath="/"
>
  <Hero lang={lang} />
  <Book847Section lang={lang} />
  <SeriesIntro lang={lang} />
  <BookCarousel lang={lang} />
</BaseLayout>
