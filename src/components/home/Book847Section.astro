---
import type { Lang } from '../../i18n/ui';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';
---

<section class="py-20 md:py-28 bg-gradient-to-b from-night-950 via-slate-950 to-night-950 border-y border-slate-800/40">
  <div class="max-w-6xl mx-auto px-4">

    <!-- Section label -->
    <p class="text-center font-mono text-xs text-emerald-500/60 tracking-widest uppercase mb-14">
      {es ? 'Nuevo libro' : 'New book'}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">

      <!-- Book visual -->
      <div class="flex justify-center">
        <div class="relative w-64 md:w-80">
          <!-- Glow -->
          <div class="absolute inset-0 rounded-2xl bg-emerald-500/10 blur-2xl scale-110" aria-hidden="true"></div>
          <!-- Cover card -->
          <div class="relative aspect-[3/4] bg-gradient-to-b from-slate-900 to-slate-950 rounded-2xl border border-emerald-500/20 flex flex-col items-start justify-between p-6 shadow-2xl">
            <!-- Top: system log line -->
            <div class="w-full">
              <p class="font-mono text-[10px] text-emerald-500/50 leading-relaxed">
                &gt; UEBA_v847<br />
                &gt; nodo_autor | iniciando...<br />
                &gt; patrones_detectados: 847
              </p>
            </div>
            <!-- Center: title -->
            <div class="w-full text-center">
              <div class="font-mono text-8xl font-bold text-emerald-400 leading-none drop-shadow-lg">
                847
              </div>
              <div class="mt-4 text-slate-400 text-sm italic">
                {t('book847.subtitle')}
              </div>
            </div>
            <!-- Bottom: author + badge -->
            <div class="w-full flex items-end justify-between">
              <span class="font-mono text-xs text-slate-500">beetecu</span>
              <span class="font-mono text-[10px] text-emerald-500/60 border border-emerald-500/20 rounded px-2 py-0.5">
                {t('book847.badge')}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Text content -->
      <div>
        <span class="inline-block px-3 py-1 bg-emerald-500/10 text-emerald-400 text-xs font-mono font-bold rounded border border-emerald-500/20 mb-5">
          {t('book847.genre').toUpperCase()} · {t('book847.badge').toUpperCase()}
        </span>

        <h2 class="font-title text-5xl md:text-6xl font-bold text-white mb-2 leading-none">
          847
        </h2>
        <p class="text-emerald-400 text-lg italic mb-6">
          {t('book847.subtitle')}
        </p>

        <p class="text-slate-300 text-lg leading-relaxed mb-8">
          {t('book847.teaser')}
        </p>

        <a
          href={getLocalizedPath(lang, '/847')}
          class="inline-block px-8 py-4 border-2 border-emerald-500 text-emerald-400 hover:bg-emerald-500 hover:text-night-950 font-bold text-base rounded-full transition-colors"
        >
          {t('book847.cta')} →
        </a>
      </div>

    </div>
  </div>
</section>
